##private CV bucket; presigned URLs are generated by the backend-api
##lambda (see the backend-api module)

resource "aws_s3_bucket" "cv" {
  bucket = var.bucket_name
}


resource "aws_s3_bucket_public_access_block" "cv" {
  bucket = aws_s3_bucket.cv.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}


##the browser uploads directly to the bucket with the presigned URL:
##CORS for the PUT, restricted to the allowed frontend origins
resource "aws_s3_bucket_cors_configuration" "cv" {
  bucket = aws_s3_bucket.cv.id

  cors_rule {
    allowed_methods = ["PUT"]
    allowed_origins = var.allowed_origins
    allowed_headers = ["content-type"]
    max_age_seconds = 3600
  }
}
